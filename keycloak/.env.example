# =============================================================================
# Copy to .env and fill in real values.  NEVER commit .env (see .gitignore).
# =============================================================================

# --- Public identity ---------------------------------------------------------
PUBLIC_HOSTNAME=auth.example.co.za
ACME_EMAIL=admin@example.co.za

# --- Image versions (pin deliberately; bump on purpose, not by accident) -----
# Check https://quay.io/repository/keycloak/keycloak?tab=tags for the latest 26.x
KEYCLOAK_IMAGE_TAG=26.3
# Pin the Postgres MAJOR: a pg_dump is restorable across minors but not majors.
POSTGRES_IMAGE_TAG=17

# --- Database (POSTGRES_USER/DB must match the KC_DB_* values) ----------------
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=CHANGE_ME_long_random

# --- Keycloak first-boot admin (delete after creating a real admin user) -----
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_long_random

# --- Separate Postgres data volume (see bootstrap.sh) ------------------------
# The block volume you attached in xneelo. Usually /dev/vdb (root is /dev/vda).
# Verify with `lsblk` before first run.
DATA_DEVICE=/dev/vdb
DATA_MOUNT=/srv/postgres-data

# --- Off-site backup: restic -> European S3-compatible storage ---------------
# e.g. s3:https://<endpoint>/<bucket>/keycloak   (Hetzner/Scaleway/OVH)
RESTIC_REPOSITORY=s3:https://REGION.example-eu.com/BUCKET/keycloak
RESTIC_PASSWORD=CHANGE_ME_long_random
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
